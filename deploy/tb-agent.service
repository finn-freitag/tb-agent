[Unit]
Description=Tossbox node agent
Documentation=https://github.com/finn-freitag/tb-agent
Wants=network-online.target
After=network-online.target libvirtd.service docker.service incus.service

[Service]
Type=simple
ExecStart=/usr/local/bin/tb-agent run -config /etc/tb-agent/node.yaml
Restart=always
RestartSec=5
# Needs access to the libvirt/Docker/Incus sockets; root is simplest. To run
# unprivileged, use a dedicated user in the libvirt (and docker) groups.
User=root
StateDirectory=tb-agent
StateDirectoryMode=0700
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
