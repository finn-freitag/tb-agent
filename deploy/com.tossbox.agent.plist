<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd job for macOS (orchard) nodes:
     sudo cp com.tossbox.agent.plist /Library/LaunchDaemons/
     sudo launchctl bootstrap system /Library/LaunchDaemons/com.tossbox.agent.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tossbox.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/tb-agent</string>
    <string>run</string>
    <string>-config</string>
    <string>/usr/local/etc/tb-agent/node.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/tb-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/tb-agent.log</string>
</dict>
</plist>
